#include <stdio.h>

int main() {
  
  int x[3][3];
  int valor = 0;
  
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            x[i][j] = valor;
            valor++;
        }}

    printf("Matriz 3x3:\n");
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            printf("%d ", x[i][j]);
            
            if ((i * 3 + j + 1) % 3 == 0) {
                printf("\n");
        }}}
    return 0;
}
